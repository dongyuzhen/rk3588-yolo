# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  RK3588 智慧工地安防系统 — .gitignore                                       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── 编译输出 ──────────────────────────────────────────────────────────────────
build/
cmake-build-*/
*.o
*.obj
*.exe
*.out
*.app

# ── CMake 中间文件 ───────────────────────────────────────────────────────────
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# ── 运行时产物 (不在 build/ 下也需要忽略) ─────────────────────────────────────
violations/
*.avi
*.mp4
*.mkv
*.flv
*.mov
*.h264
*.h265
*.hevc

# ── 日志 & 数据 ──────────────────────────────────────────────────────────────
*.log
*.csv
error_log.txt

# ── 第三方预编译库 — 不上传，用户自行配置 ────────────────────────────────────
3rdparty/**/*.so
3rdparty/**/*.a

# ── IDE & 编辑器 ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── 模型文件 — 保留 (release 所必须) ──────────────────────────────────────────
# model/*.rknn 和 model/*_labels.txt 需要上传
# 如果要忽略大模型文件，单独添加:
# model/best.rknn

# ── 临时文件 ──────────────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*_copy.*

# ── 压缩包 ───────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tar.xz
*.7z
*.rar

# ── OS 生成文件 ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
